<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#" name="sugar_ebm_superset">

  <units name="day">
    <unit units="second" multiplier="86400.0"/>
  </units>
  <units name="per_day">
    <unit units="day" exponent="-1"/>
  </units>
  <units name="g_C">
    <unit units="gram"/>
  </units>
  <units name="g_C_per_mol">
    <unit units="gram"/>
    <unit units="mole" exponent="-1"/>
  </units>
  <units name="mol_per_kg">
    <unit units="mole"/>
    <unit units="kilogram" exponent="-1"/>
  </units>
  <units name="J_per_mol">
    <unit units="joule"/>
    <unit units="mole" exponent="-1"/>
  </units>
  <units name="m3">
    <unit units="metre" exponent="3"/>
  </units>
  <units name="kg_per_m3">
    <unit units="kilogram"/>
    <unit units="metre" exponent="-3"/>
  </units>
  <units name="m3_per_day">
    <unit units="metre" exponent="3"/>
    <unit units="day" exponent="-1"/>
  </units>
  <units name="m3_per_Pa_day">
    <unit units="metre" exponent="3"/>
    <unit units="pascal" exponent="-1"/>
    <unit units="day" exponent="-1"/>
  </units>
  <units name="Pa">
    <unit units="pascal"/>
  </units>
  <units name="mol_per_kg_day">
    <unit units="mole"/>
    <unit units="kilogram" exponent="-1"/>
    <unit units="day" exponent="-1"/>
  </units>
  <units name="kg_per_mol">
    <unit units="kilogram"/>
    <unit units="mole" exponent="-1"/>
  </units>
  <units name="g_C_per_day">
    <unit units="gram"/>
    <unit units="day" exponent="-1"/>
  </units>
  <units name="g_C_per_day2">
    <unit units="gram"/>
    <unit units="day" exponent="-2"/>
  </units>

  <component name="environment">
    <variable name="t" units="day" interface="public"/>
  </component>

  <component name="parameters">
    <!-- Physical constants and unoptimized parameters (kept from original) -->
    <variable name="M_SUC_C" units="g_C_per_mol" initial_value="144.0" interface="public"/>
    <variable name="M_HEX_C" units="g_C_per_mol" initial_value="72.0" interface="public"/>
    <variable name="PHI_N" units="J_per_mol" initial_value="2436.0" interface="public"/>
    <variable name="rho_water" units="kg_per_m3" initial_value="1000.0" interface="public"/>
    
    <variable name="ALPHA_V" units="dimensionless" initial_value="0.85" interface="public"/>
    <variable name="ALPHA_C" units="dimensionless" initial_value="0.10" interface="public"/>
    <variable name="ALPHA_P" units="dimensionless" initial_value="0.05" interface="public"/>

    <variable name="delta_lockhart" units="Pa" initial_value="5000.0" interface="public"/>
    <variable name="EFF_H_V" units="dimensionless" initial_value="1.0" interface="public"/>
    <variable name="EFF_H_C" units="dimensionless" initial_value="0.6309573" interface="public"/>
    <variable name="PHYSIO_ATP_RATIO" units="dimensionless" initial_value="10.0" interface="public"/>
    <variable name="PHYSIO_ADP_RATIO" units="dimensionless" initial_value="1.0" interface="public"/>

    <!-- Thermohydraulic & Structural Parameters (Table 1) -->
    <variable name="Y" units="Pa" initial_value="99770.0" interface="public"/> 
    <variable name="epsilon" units="Pa" initial_value="9.79e6" interface="public"/>
    <variable name="phi_W" units="m3_per_Pa_day" initial_value="1.07e-11" interface="public"/> 
    <variable name="L_x" units="m3_per_Pa_day" initial_value="9.93e-11" interface="public"/>
    <variable name="L_p" units="m3_per_Pa_day" initial_value="6.69e-12" interface="public"/>
    <variable name="g_skin" units="m3_per_Pa_day" initial_value="2.57e-13" interface="public"/>
    <variable name="Pi_phloem_sap" units="Pa" initial_value="1.02e6" interface="public"/>
    <variable name="lambda_apo" units="dimensionless" initial_value="0.9998" interface="public"/>
    <variable name="C_bg" units="mol_per_kg" initial_value="0.100" interface="public"/>

    <!-- Thermodynamic Equilibrium and Affinity Constants (Table 2) -->
    <variable name="K_Suc_c" units="kg_per_mol" initial_value="0.442" interface="public"/>
    <variable name="K_Suc_v" units="kg_per_mol" initial_value="2355.0" interface="public"/>
    <variable name="K_Sor_c" units="kg_per_mol" initial_value="1.58" interface="public"/>
    <variable name="K_Glu_c" units="kg_per_mol" initial_value="72.3" interface="public"/>
    <variable name="K_Glu_v" units="kg_per_mol" initial_value="9862.0" interface="public"/>
    <variable name="K_Fru_c" units="kg_per_mol" initial_value="2023.0" interface="public"/>
    <variable name="K_Fru_v" units="kg_per_mol" initial_value="1.16" interface="public"/>
    <variable name="K_Glu_p" units="kg_per_mol" initial_value="54.2" interface="public"/>
    <variable name="K_Sta_p" units="dimensionless" initial_value="0.102" interface="public"/>
    <variable name="D_redox" units="dimensionless" initial_value="475.3" interface="public"/>

    <!-- Metabolic Kinetic Rates and Transporters (Table 3) -->
    <variable name="k_INV" units="mol_per_kg_day" initial_value="4.18e-3" interface="public"/>
    <variable name="k_SDH1" units="mol_per_kg_day" initial_value="4.12e-5" interface="public"/>
    <variable name="k_SDH2" units="mol_per_kg_day" initial_value="4.07e-5" interface="public"/>
    <variable name="k_ISO" units="mol_per_kg_day" initial_value="1.09e-3" interface="public"/>
    <variable name="k_TSuc" units="mol_per_kg_day" initial_value="2.51e-4" interface="public"/>
    <variable name="k_TGlu" units="mol_per_kg_day" initial_value="0.263" interface="public"/>
    <variable name="k_TFru" units="mol_per_kg_day" initial_value="0.997" interface="public"/>
    <variable name="k_TPGlu" units="mol_per_kg_day" initial_value="0.066" interface="public"/>
    <variable name="k_STA" units="mol_per_kg_day" initial_value="9.80e-3" interface="public"/>
    <variable name="k_Resp" units="mol_per_kg_day" initial_value="3.91e-8" interface="public"/>
    <variable name="k_Syn" units="mol_per_kg_day" initial_value="4.81e-8" interface="public"/>
    <variable name="k_INV_v" units="mol_per_kg_day" initial_value="1.05e-6" interface="public"/>
    <variable name="k_AMY_max" units="mol_per_kg_day" initial_value="5.52" interface="public"/>
    <variable name="r_AMY" units="per_day" initial_value="0.0227" interface="public"/>
  </component>

  <component name="boundary_conditions">
    <variable name="t" units="day" interface="public"/>
    
    <variable name="u_stem_water" units="Pa" initial_value="-500000.0" interface="public"/>
    <variable name="u_atm_water" units="Pa" initial_value="1500.0" interface="public"/>

    <variable name="u_sor_base" units="g_C_per_day" initial_value="0.0"/>
    <variable name="x_phloem_suc_base" units="mol_per_kg" initial_value="0.0"/>
    <variable name="x_phloem_sor_base" units="mol_per_kg" initial_value="0.0"/>
    <variable name="t_rip_base" units="day" initial_value="118.0"/>
    
    <variable name="u_unload_sor" units="g_C_per_day" interface="public"/>
    <variable name="x_phloem_suc" units="mol_per_kg" interface="public"/>
    <variable name="x_phloem_sor" units="mol_per_kg" interface="public"/>
    <variable name="t_rip" units="day" interface="public"/>

    <variable name="zero_g_day2" units="g_C_per_day2" initial_value="0.0"/>
    <variable name="zero_mol_kg_day" units="mol_per_kg_day" initial_value="0.0"/>
    <variable name="zero_dim" units="dimensionless" initial_value="0.0"/>

    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply><eq/><ci>u_unload_sor</ci>
        <apply><plus/><ci>u_sor_base</ci><apply><times/><ci>t</ci><ci>zero_g_day2</ci></apply></apply>
      </apply>

      <apply><eq/><ci>x_phloem_suc</ci>
        <apply><plus/><ci>x_phloem_suc_base</ci><apply><times/><ci>t</ci><ci>zero_mol_kg_day</ci></apply></apply>
      </apply>

      <apply><eq/><ci>x_phloem_sor</ci>
        <apply><plus/><ci>x_phloem_sor_base</ci><apply><times/><ci>t</ci><ci>zero_mol_kg_day</ci></apply></apply>
      </apply>

      <apply><eq/><ci>t_rip</ci>
        <apply><plus/><ci>t_rip_base</ci><apply><times/><ci>t</ci><ci>zero_dim</ci></apply></apply>
      </apply>
    </math>
  </component>

   <component name="thermohydraulics">
    <variable name="t" units="day" interface="public"/>
    
    <variable name="q_total_vol" units="m3" initial_value="0.00001" interface="public"/>
    <variable name="q_p_vol" units="m3" initial_value="0.0000095"/>
    <variable name="q_e_vol" units="m3"/>
    
    <variable name="u_stem_water" units="Pa" interface="public"/>
    <variable name="u_atm_water" units="Pa" interface="public"/>

    <variable name="M_SUC_C" units="g_C_per_mol" interface="public"/>
    <variable name="M_HEX_C" units="g_C_per_mol" interface="public"/>
    <variable name="PHI_N" units="J_per_mol" interface="public"/>
    <variable name="rho_water" units="kg_per_m3" interface="public"/>
    <variable name="C_bg" units="mol_per_kg" interface="public"/>
    <variable name="Y" units="Pa" interface="public"/>
    <variable name="phi_W" units="m3_per_Pa_day" interface="public"/>
    <variable name="delta_lockhart" units="Pa" interface="public"/>
    <variable name="L_x" units="m3_per_Pa_day" interface="public"/>
    <variable name="L_p" units="m3_per_Pa_day" interface="public"/>
    <variable name="g_skin" units="m3_per_Pa_day" interface="public"/>
    <variable name="epsilon" units="Pa" interface="public"/>
    <variable name="Pi_phloem_sap" units="Pa" interface="public"/>
    <variable name="x_phloem_suc" units="mol_per_kg" interface="public"/>

    <variable name="q_c_suc" units="g_C" interface="public"/>
    <variable name="q_v_suc" units="g_C" interface="public"/>
    <variable name="q_c_sor" units="g_C" interface="public"/>
    <variable name="q_c_glu" units="g_C" interface="public"/>
    <variable name="q_v_glu" units="g_C" interface="public"/>
    <variable name="q_p_glu" units="g_C" interface="public"/>
    <variable name="q_c_fru" units="g_C" interface="public"/>
    <variable name="q_v_fru" units="g_C" interface="public"/>

    <variable name="W_kg" units="kilogram" interface="public"/>
    <variable name="total_moles" units="mole"/>
    <variable name="bulk_osmolarity" units="mol_per_kg"/>
    <variable name="u_fruit_osmotic" units="Pa"/>
    <variable name="u_fruit_turgor" units="Pa"/>
    <variable name="delta_P" units="Pa"/>
    <variable name="yield_val" units="Pa"/>
    
    <variable name="v_t_water" units="m3_per_day"/>
    <variable name="v_x_water" units="m3_per_day"/>
    <variable name="v_p_water" units="m3_per_day"/>
    <variable name="v_growth_water" units="m3_per_day"/>
    <variable name="v_in_suc" units="g_C_per_day" interface="public"/>

    <math xmlns="http://www.w3.org/1998/Math/MathML">
      
      <apply><eq/><ci>W_kg</ci>
        <piecewise>
          <piece>
            <apply><times/><ci>q_total_vol</ci><ci>rho_water</ci></apply>
            <apply><gt/>
              <apply><times/><ci>q_total_vol</ci><ci>rho_water</ci></apply>
              <cn cellml:units="kilogram">0.000000001</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="kilogram">0.000000001</cn>
          </otherwise>
        </piecewise>
      </apply>

      <apply><eq/><ci>total_moles</ci>
        <apply><plus/>
          <apply><divide/>
            <apply><plus/><ci>q_c_suc</ci><ci>q_v_suc</ci></apply>
            <ci>M_SUC_C</ci>
          </apply>
          <apply><divide/><ci>q_c_sor</ci><ci>M_HEX_C</ci></apply>
          <apply><divide/>
            <apply><plus/><ci>q_c_glu</ci><ci>q_v_glu</ci><ci>q_p_glu</ci></apply>
            <ci>M_HEX_C</ci>
          </apply>
          <apply><divide/>
            <apply><plus/><ci>q_c_fru</ci><ci>q_v_fru</ci></apply>
            <ci>M_HEX_C</ci>
          </apply>
        </apply>
      </apply>

      <apply><eq/><ci>bulk_osmolarity</ci>
        <apply><plus/>
          <apply><divide/><ci>total_moles</ci><ci>W_kg</ci></apply>
          <ci>C_bg</ci>
        </apply>
      </apply>

      <apply><eq/><ci>u_fruit_osmotic</ci>
        <apply><times/>
          <apply><times/><ci>bulk_osmolarity</ci><ci>rho_water</ci></apply>
          <ci>PHI_N</ci>
        </apply>
      </apply>

      <apply><eq/><ci>q_e_vol</ci>
        <apply><minus/><ci>q_total_vol</ci><ci>q_p_vol</ci></apply>
      </apply>

      <apply><eq/><ci>u_fruit_turgor</ci>
        <apply><times/>
          <ci>epsilon</ci>
          <apply><divide/><ci>q_e_vol</ci><ci>q_total_vol</ci></apply>
        </apply>
      </apply>

      <apply><eq/><ci>v_t_water</ci>
        <apply><times/><ci>g_skin</ci><ci>u_atm_water</ci></apply>
      </apply>

      <apply><eq/><ci>v_x_water</ci>
        <apply><times/><ci>L_x</ci>
          <apply><plus/>
            <apply><minus/><ci>u_stem_water</ci><ci>u_fruit_turgor</ci></apply>
            <ci>u_fruit_osmotic</ci>
          </apply>
        </apply>
      </apply>

      <apply><eq/><ci>v_p_water</ci>
        <apply><times/><ci>L_p</ci>
          <apply><plus/>
            <apply><minus/>
              <apply><plus/><ci>u_stem_water</ci><ci>Pi_phloem_sap</ci></apply>
              <ci>u_fruit_turgor</ci>
            </apply>
            <ci>u_fruit_osmotic</ci>
          </apply>
        </apply>
      </apply>

      <apply><eq/><ci>delta_P</ci>
        <apply><minus/><ci>u_fruit_turgor</ci><ci>Y</ci></apply>
      </apply>

      <apply><eq/><ci>yield_val</ci>
        <piecewise>
          <piece>
            <ci>delta_P</ci>
            <apply><gt/>
              <ci>delta_P</ci>
              <apply><times/><cn cellml:units="dimensionless">50.0</cn><ci>delta_lockhart</ci></apply>
            </apply>
          </piece>
          <piece>
            <cn cellml:units="Pa">0.0</cn>
            <apply><lt/>
              <ci>delta_P</ci>
              <apply><times/><cn cellml:units="dimensionless">-50.0</cn><ci>delta_lockhart</ci></apply>
            </apply>
          </piece>
          <otherwise>
            <apply><times/>
              <ci>delta_lockhart</ci>
              <apply><ln/>
                <apply><plus/>
                  <cn cellml:units="dimensionless">1.0</cn>
                  <apply><exp/>
                    <apply><divide/><ci>delta_P</ci><ci>delta_lockhart</ci></apply>
                  </apply>
                </apply>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>

      <apply><eq/><ci>v_growth_water</ci>
        <apply><times/><ci>phi_W</ci><ci>yield_val</ci></apply>
      </apply>
      
      <apply><eq/>
        <apply><diff/><bvar><ci>t</ci></bvar><ci>q_total_vol</ci></apply>
        <apply><minus/>
          <apply><plus/><ci>v_x_water</ci><ci>v_p_water</ci></apply>
          <ci>v_t_water</ci>
        </apply>
      </apply>

      <apply><eq/>
        <apply><diff/><bvar><ci>t</ci></bvar><ci>q_p_vol</ci></apply>
        <ci>v_growth_water</ci>
      </apply>

      <apply><eq/><ci>v_in_suc</ci>
        <apply><times/>
          <piecewise>
            <piece>
              <ci>v_p_water</ci>
              <apply><gt/><ci>v_p_water</ci><cn cellml:units="m3_per_day">0.0</cn></apply>
            </piece>
            <otherwise>
              <cn cellml:units="m3_per_day">0.0</cn>
            </otherwise>
          </piecewise>
          <apply><times/><ci>x_phloem_suc</ci><ci>rho_water</ci></apply>
          <ci>M_SUC_C</ci>
        </apply>
      </apply>

    </math>
  </component>


  <component name="cytosol">
    <variable name="t" units="day" interface="public"/>
    <variable name="W_kg" units="kilogram" interface="public"/>
    
    <variable name="q_c_suc" units="g_C" initial_value="0.005" interface="public"/>
    <variable name="q_c_sor" units="g_C" initial_value="0.010" interface="public"/>
    <variable name="q_c_glu" units="g_C" initial_value="0.002" interface="public"/>
    <variable name="q_c_fru" units="g_C" initial_value="0.002" interface="public"/>

    <variable name="ALPHA_C" units="dimensionless" interface="public"/>
    <variable name="M_SUC_C" units="g_C_per_mol" interface="public"/>
    <variable name="M_HEX_C" units="g_C_per_mol" interface="public"/>
    <variable name="D_redox" units="dimensionless" interface="public"/>
    <variable name="lambda_apo" units="dimensionless" interface="public"/>
    <variable name="u_in_suc" units="g_C_per_day" interface="public"/>
    <variable name="u_unload_sor" units="g_C_per_day" interface="public"/>
    <variable name="x_phloem_suc" units="mol_per_kg" interface="public"/>
    <variable name="x_phloem_sor" units="mol_per_kg" interface="public"/>

    <variable name="K_Suc_c" units="kg_per_mol" interface="public"/>
    <variable name="K_Sor_c" units="kg_per_mol" interface="public"/>
    <variable name="K_Glu_c" units="kg_per_mol" interface="public"/>
    <variable name="K_Fru_c" units="kg_per_mol" interface="public"/>
    <variable name="k_INV" units="mol_per_kg_day" interface="public"/>
    <variable name="k_SDH1" units="mol_per_kg_day" interface="public"/>
    <variable name="k_SDH2" units="mol_per_kg_day" interface="public"/>
    <variable name="k_ISO" units="mol_per_kg_day" interface="public"/>
    <variable name="k_Resp" units="mol_per_kg_day" interface="public"/>
    <variable name="k_Syn" units="mol_per_kg_day" interface="public"/>

    <variable name="v_T_suc" units="g_C_per_day" interface="public"/>
    <variable name="v_T_glu" units="g_C_per_day" interface="public"/>
    <variable name="v_T_fru" units="g_C_per_day" interface="public"/>
    <variable name="v_T_p_glu" units="g_C_per_day" interface="public"/>

    <variable name="u_c_suc" units="mol_per_kg" interface="public"/>
    <variable name="u_c_sor" units="mol_per_kg" interface="public"/>
    <variable name="u_c_glu" units="mol_per_kg" interface="public"/>
    <variable name="u_c_fru" units="mol_per_kg" interface="public"/>
    <variable name="sap_suc_safe" units="mol_per_kg"/>
    <variable name="sap_sor_safe" units="mol_per_kg"/>
    <variable name="ratio_sym" units="dimensionless"/>
    <variable name="ratio_apo" units="dimensionless"/>
    <variable name="ratio_sor" units="dimensionless"/>
    <variable name="theta_sym" units="dimensionless"/>
    <variable name="theta_apo" units="dimensionless"/>
    <variable name="theta_sor" units="dimensionless"/>
    
    <variable name="v_sym_suc" units="g_C_per_day"/>
    <variable name="v_apo_hex" units="g_C_per_day"/>
    <variable name="v_unload_sor" units="g_C_per_day"/>
    <variable name="f_inv_suc" units="mol_per_kg_day"/>
    <variable name="f_sdh_sor" units="mol_per_kg_day"/>
    <variable name="f_sdh2_sor" units="mol_per_kg_day"/>
    <variable name="f_iso_hex" units="mol_per_kg_day"/>
    <variable name="f_resp_hex" units="mol_per_kg_day"/>
    <variable name="f_syn_hex" units="mol_per_kg_day"/>
    
    <variable name="v_inv_suc" units="g_C_per_day"/>
    <variable name="v_sdh_sor" units="g_C_per_day"/>
    <variable name="v_sdh2_sor" units="g_C_per_day"/>
    <variable name="v_iso_hex" units="g_C_per_day"/>
    <variable name="v_resp_hex" units="g_C_per_day"/>
    <variable name="v_syn_hex" units="g_C_per_day"/>

    <math xmlns="http://www.w3.org/1998/Math/MathML">
      
      <apply><eq/><ci>u_c_suc</ci>
        <apply><divide/><ci>q_c_suc</ci><apply><times/><ci>M_SUC_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      </apply>
      <apply><eq/><ci>u_c_sor</ci>
        <apply><divide/><ci>q_c_sor</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      </apply>
      <apply><eq/><ci>u_c_glu</ci>
        <apply><divide/><ci>q_c_glu</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      </apply>
      <apply><eq/><ci>u_c_fru</ci>
        <apply><divide/><ci>q_c_fru</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      </apply>

      <apply><eq/><ci>sap_suc_safe</ci>
        <piecewise><piece><ci>x_phloem_suc</ci><apply><gt/><ci>x_phloem_suc</ci><cn cellml:units="mol_per_kg">0.000001</cn></apply></piece><otherwise><cn cellml:units="mol_per_kg">0.000001</cn></otherwise></piecewise>
      </apply>
      <apply><eq/><ci>sap_sor_safe</ci>
        <piecewise><piece><ci>x_phloem_sor</ci><apply><gt/><ci>x_phloem_sor</ci><cn cellml:units="mol_per_kg">0.000001</cn></apply></piece><otherwise><cn cellml:units="mol_per_kg">0.000001</cn></otherwise></piecewise>
      </apply>

      <apply><eq/><ci>ratio_sym</ci><apply><divide/><apply><minus/><ci>sap_suc_safe</ci><ci>u_c_suc</ci></apply><ci>sap_suc_safe</ci></apply></apply>
      <apply><eq/><ci>ratio_apo</ci><apply><divide/><apply><minus/><ci>sap_suc_safe</ci><apply><divide/><apply><plus/><ci>u_c_glu</ci><ci>u_c_fru</ci></apply><cn cellml:units="dimensionless">2.0</cn></apply></apply><ci>sap_suc_safe</ci></apply></apply>
      <apply><eq/><ci>ratio_sor</ci><apply><divide/><apply><minus/><ci>sap_sor_safe</ci><ci>u_c_sor</ci></apply><ci>sap_sor_safe</ci></apply></apply>

      <apply><eq/><ci>theta_sym</ci><piecewise><piece><cn cellml:units="dimensionless">0.0</cn><apply><lt/><ci>ratio_sym</ci><cn cellml:units="dimensionless">0.0</cn></apply></piece><piece><cn cellml:units="dimensionless">1.0</cn><apply><gt/><ci>ratio_sym</ci><cn cellml:units="dimensionless">1.0</cn></apply></piece><otherwise><ci>ratio_sym</ci></otherwise></piecewise></apply>
      <apply><eq/><ci>theta_apo</ci><piecewise><piece><cn cellml:units="dimensionless">0.0</cn><apply><lt/><ci>ratio_apo</ci><cn cellml:units="dimensionless">0.0</cn></apply></piece><piece><cn cellml:units="dimensionless">1.0</cn><apply><gt/><ci>ratio_apo</ci><cn cellml:units="dimensionless">1.0</cn></apply></piece><otherwise><ci>ratio_apo</ci></otherwise></piecewise></apply>
      <apply><eq/><ci>theta_sor</ci><piecewise><piece><cn cellml:units="dimensionless">0.0</cn><apply><lt/><ci>ratio_sor</ci><cn cellml:units="dimensionless">0.0</cn></apply></piece><piece><cn cellml:units="dimensionless">1.0</cn><apply><gt/><ci>ratio_sor</ci><cn cellml:units="dimensionless">1.0</cn></apply></piece><otherwise><ci>ratio_sor</ci></otherwise></piecewise></apply>

      <apply><eq/><ci>v_sym_suc</ci><apply><times/><apply><minus/><cn cellml:units="dimensionless">1.0</cn><ci>lambda_apo</ci></apply><ci>u_in_suc</ci><ci>theta_sym</ci></apply></apply>
      <apply><eq/><ci>v_apo_hex</ci><apply><times/><ci>lambda_apo</ci><ci>u_in_suc</ci><ci>theta_apo</ci></apply></apply>
      <apply><eq/><ci>v_unload_sor</ci><apply><times/><ci>u_unload_sor</ci><ci>theta_sor</ci></apply></apply>

      <apply><eq/><ci>f_inv_suc</ci>
        <apply><times/><ci>k_INV</ci><apply><minus/><apply><times/><ci>K_Suc_c</ci><ci>u_c_suc</ci></apply><apply><times/><ci>K_Glu_c</ci><ci>u_c_glu</ci><ci>K_Fru_c</ci><ci>u_c_fru</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_sdh_sor</ci>
        <apply><times/><ci>k_SDH1</ci><apply><minus/><apply><times/><ci>K_Sor_c</ci><ci>u_c_sor</ci><ci>D_redox</ci></apply><apply><times/><ci>K_Fru_c</ci><ci>u_c_fru</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_sdh2_sor</ci>
        <apply><times/><ci>k_SDH2</ci><apply><minus/><apply><times/><ci>K_Sor_c</ci><ci>u_c_sor</ci><ci>D_redox</ci></apply><apply><times/><ci>K_Glu_c</ci><ci>u_c_glu</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_iso_hex</ci>
        <apply><times/><ci>k_ISO</ci><apply><minus/><apply><times/><ci>K_Glu_c</ci><ci>u_c_glu</ci></apply><apply><times/><ci>K_Fru_c</ci><ci>u_c_fru</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_resp_hex</ci><apply><times/><ci>k_Resp</ci><ci>K_Fru_c</ci><ci>u_c_fru</ci></apply></apply>
      <apply><eq/><ci>f_syn_hex</ci><apply><times/><ci>k_Syn</ci><ci>K_Glu_c</ci><ci>u_c_glu</ci></apply></apply>

      <apply><eq/><ci>v_inv_suc</ci><apply><times/><ci>f_inv_suc</ci><ci>M_SUC_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      <apply><eq/><ci>v_sdh_sor</ci><apply><times/><ci>f_sdh_sor</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      <apply><eq/><ci>v_sdh2_sor</ci><apply><times/><ci>f_sdh2_sor</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      <apply><eq/><ci>v_iso_hex</ci><apply><times/><ci>f_iso_hex</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      <apply><eq/><ci>v_resp_hex</ci><apply><times/><ci>f_resp_hex</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>
      <apply><eq/><ci>v_syn_hex</ci><apply><times/><ci>f_syn_hex</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_C</ci></apply></apply>

      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_c_suc</ci></apply>
        <apply><minus/><apply><minus/><ci>v_sym_suc</ci><ci>v_inv_suc</ci></apply><ci>v_T_suc</ci></apply>
      </apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_c_sor</ci></apply>
        <apply><minus/><apply><minus/><ci>v_unload_sor</ci><ci>v_sdh_sor</ci></apply><ci>v_sdh2_sor</ci></apply>
      </apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_c_glu</ci></apply>
        <apply><minus/><apply><minus/><apply><minus/><apply><plus/><apply><plus/><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_apo_hex</ci></apply><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_inv_suc</ci></apply></apply><ci>v_sdh2_sor</ci></apply><ci>v_iso_hex</ci></apply><ci>v_T_glu</ci></apply><apply><plus/><ci>v_T_p_glu</ci><ci>v_syn_hex</ci></apply></apply>
      </apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_c_fru</ci></apply>
        <apply><minus/><apply><minus/><apply><plus/><apply><plus/><apply><plus/><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_apo_hex</ci></apply><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_inv_suc</ci></apply></apply><ci>v_sdh_sor</ci></apply><ci>v_iso_hex</ci></apply><ci>v_T_fru</ci></apply><ci>v_resp_hex</ci></apply>
      </apply>

    </math>
  </component>

<component name="vacuole">
    <variable name="t" units="day" interface="public"/>
    <variable name="W_kg" units="kilogram" interface="public"/>
    
    <variable name="q_v_suc" units="g_C" initial_value="0.025" interface="public"/>
    <variable name="q_v_glu" units="g_C" initial_value="0.018" interface="public"/>
    <variable name="q_v_fru" units="g_C" initial_value="0.018" interface="public"/>

    <variable name="ALPHA_V" units="dimensionless" interface="public"/>
    <variable name="M_SUC_C" units="g_C_per_mol" interface="public"/>
    <variable name="M_HEX_C" units="g_C_per_mol" interface="public"/>
    <variable name="EFF_H_V" units="dimensionless" interface="public"/>
    <variable name="EFF_H_C" units="dimensionless" interface="public"/>

    <variable name="u_c_suc" units="mol_per_kg" interface="public"/>
    <variable name="u_c_glu" units="mol_per_kg" interface="public"/>
    <variable name="u_c_fru" units="mol_per_kg" interface="public"/>
    <variable name="K_Suc_c" units="kg_per_mol" interface="public"/>
    <variable name="K_Glu_c" units="kg_per_mol" interface="public"/>
    <variable name="K_Fru_c" units="kg_per_mol" interface="public"/>

    <variable name="K_Suc_v" units="kg_per_mol" interface="public"/>
    <variable name="K_Glu_v" units="kg_per_mol" interface="public"/>
    <variable name="K_Fru_v" units="kg_per_mol" interface="public"/>
    <variable name="k_TSuc" units="mol_per_kg_day" interface="public"/>
    <variable name="k_TGlu" units="mol_per_kg_day" interface="public"/>
    <variable name="k_TFru" units="mol_per_kg_day" interface="public"/>
    <variable name="k_INV_v" units="mol_per_kg_day" interface="public"/>

    <variable name="u_v_suc" units="mol_per_kg" interface="public"/>
    <variable name="u_v_glu" units="mol_per_kg" interface="public"/>
    <variable name="u_v_fru" units="mol_per_kg" interface="public"/>

    <variable name="f_T_suc" units="mol_per_kg_day"/>
    <variable name="f_T_glu" units="mol_per_kg_day"/>
    <variable name="f_T_fru" units="mol_per_kg_day"/>
    <variable name="f_inv_v_suc" units="mol_per_kg_day"/>

    <variable name="v_T_suc" units="g_C_per_day" interface="public"/>
    <variable name="v_T_glu" units="g_C_per_day" interface="public"/>
    <variable name="v_T_fru" units="g_C_per_day" interface="public"/>
    <variable name="v_inv_v_suc" units="g_C_per_day"/>

    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply><eq/><ci>u_v_suc</ci><apply><divide/><ci>q_v_suc</ci><apply><times/><ci>M_SUC_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply></apply>
      <apply><eq/><ci>u_v_glu</ci><apply><divide/><ci>q_v_glu</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply></apply>
      <apply><eq/><ci>u_v_fru</ci><apply><divide/><ci>q_v_fru</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply></apply>

      <apply><eq/><ci>f_T_suc</ci>
        <apply><times/><ci>k_TSuc</ci><apply><minus/><apply><times/><ci>K_Suc_c</ci><ci>u_c_suc</ci><ci>EFF_H_V</ci></apply><apply><times/><ci>K_Suc_v</ci><ci>u_v_suc</ci><ci>EFF_H_C</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_T_glu</ci>
        <apply><times/><ci>k_TGlu</ci><apply><minus/><apply><times/><ci>K_Glu_c</ci><ci>u_c_glu</ci><ci>EFF_H_V</ci></apply><apply><times/><ci>K_Glu_v</ci><ci>u_v_glu</ci><ci>EFF_H_C</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_T_fru</ci>
        <apply><times/><ci>k_TFru</ci><apply><minus/><apply><times/><ci>K_Fru_c</ci><ci>u_c_fru</ci><ci>EFF_H_V</ci></apply><apply><times/><ci>K_Fru_v</ci><ci>u_v_fru</ci><ci>EFF_H_C</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_inv_v_suc</ci>
        <apply><times/><ci>k_INV_v</ci><apply><minus/><apply><times/><ci>K_Suc_v</ci><ci>u_v_suc</ci></apply><apply><times/><ci>K_Glu_v</ci><ci>u_v_glu</ci><ci>K_Fru_v</ci><ci>u_v_fru</ci></apply></apply></apply>
      </apply>

      <apply><eq/><ci>v_T_suc</ci><apply><times/><ci>f_T_suc</ci><ci>M_SUC_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply>
      <apply><eq/><ci>v_T_glu</ci><apply><times/><ci>f_T_glu</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply>
      <apply><eq/><ci>v_T_fru</ci><apply><times/><ci>f_T_fru</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply>
      <apply><eq/><ci>v_inv_v_suc</ci><apply><times/><ci>f_inv_v_suc</ci><ci>M_SUC_C</ci><ci>W_kg</ci><ci>ALPHA_V</ci></apply></apply>

      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_v_suc</ci></apply><apply><minus/><ci>v_T_suc</ci><ci>v_inv_v_suc</ci></apply></apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_v_glu</ci></apply><apply><plus/><ci>v_T_glu</ci><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_inv_v_suc</ci></apply></apply></apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_v_fru</ci></apply><apply><plus/><ci>v_T_fru</ci><apply><times/><cn cellml:units="dimensionless">0.5</cn><ci>v_inv_v_suc</ci></apply></apply></apply>
    </math>
  </component>

<component name="plastid">
    <variable name="t" units="day" interface="public"/>
    <variable name="W_kg" units="kilogram" interface="public"/>
    
    <variable name="q_p_glu" units="g_C" initial_value="0.001" interface="public"/>
    <variable name="q_p_sta" units="g_C" initial_value="0.05" interface="public"/>

    <variable name="ALPHA_P" units="dimensionless" interface="public"/>
    <variable name="M_HEX_C" units="g_C_per_mol" interface="public"/>
    <variable name="PHYSIO_ATP_RATIO" units="dimensionless" interface="public"/>
    <variable name="PHYSIO_ADP_RATIO" units="dimensionless" interface="public"/>

    <variable name="u_c_glu" units="mol_per_kg" interface="public"/>
    <variable name="K_Glu_c" units="kg_per_mol" interface="public"/>
    
    <variable name="K_Glu_p" units="kg_per_mol" interface="public"/>
    <variable name="K_Sta_p" units="dimensionless" interface="public"/>
    <variable name="k_TPGlu" units="mol_per_kg_day" interface="public"/>
    <variable name="k_STA" units="mol_per_kg_day" interface="public"/>
    <variable name="k_AMY_max" units="mol_per_kg_day" interface="public"/>
    <variable name="r_AMY" units="per_day" interface="public"/>
    <variable name="t_rip" units="day" interface="public"/>

    <variable name="u_p_glu" units="mol_per_kg" interface="public"/>
    <variable name="activity_sta" units="dimensionless"/>
    <variable name="k_AMY_t" units="mol_per_kg_day"/>
    
    <variable name="f_T_p_glu" units="mol_per_kg_day"/>
    <variable name="f_sta_C" units="mol_per_kg_day"/>
    <variable name="f_amy_C" units="mol_per_kg_day"/>
    
    <variable name="v_T_p_glu" units="g_C_per_day" interface="public"/>
    <variable name="v_sta_C" units="g_C_per_day"/>
    <variable name="v_amy_C" units="g_C_per_day"/>

    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply><eq/><ci>u_p_glu</ci><apply><divide/><ci>q_p_glu</ci><apply><times/><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_P</ci></apply></apply></apply>

      <apply><eq/><ci>k_AMY_t</ci>
        <apply><divide/><ci>k_AMY_max</ci><apply><plus/><cn cellml:units="dimensionless">1.0</cn><apply><exp/><apply><times/><apply><minus/><ci>r_AMY</ci></apply><apply><minus/><ci>t</ci><ci>t_rip</ci></apply></apply></apply></apply></apply>
      </apply>

      <apply><eq/><ci>activity_sta</ci>
        <apply><divide/><ci>q_p_sta</ci><apply><plus/><ci>q_p_sta</ci><cn cellml:units="g_C">0.0001</cn></apply></apply>
      </apply>

      <apply><eq/><ci>f_T_p_glu</ci>
        <apply><times/><ci>k_TPGlu</ci><apply><minus/><apply><times/><ci>K_Glu_c</ci><ci>u_c_glu</ci></apply><apply><times/><ci>K_Glu_p</ci><ci>u_p_glu</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_sta_C</ci>
        <apply><times/><ci>k_STA</ci><apply><minus/><apply><times/><ci>K_Glu_p</ci><ci>u_p_glu</ci><ci>PHYSIO_ATP_RATIO</ci></apply><apply><times/><ci>K_Sta_p</ci><ci>activity_sta</ci><ci>PHYSIO_ADP_RATIO</ci></apply></apply></apply>
      </apply>
      <apply><eq/><ci>f_amy_C</ci><apply><times/><ci>k_AMY_t</ci><ci>activity_sta</ci></apply></apply>

      <apply><eq/><ci>v_T_p_glu</ci><apply><times/><ci>f_T_p_glu</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_P</ci></apply></apply>
      <apply><eq/><ci>v_sta_C</ci><apply><times/><ci>f_sta_C</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_P</ci></apply></apply>
      <apply><eq/><ci>v_amy_C</ci><apply><times/><ci>f_amy_C</ci><ci>M_HEX_C</ci><ci>W_kg</ci><ci>ALPHA_P</ci></apply></apply>

      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_p_glu</ci></apply><apply><plus/><apply><minus/><ci>v_T_p_glu</ci><ci>v_sta_C</ci></apply><ci>v_amy_C</ci></apply></apply>
      <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_p_sta</ci></apply><apply><minus/><ci>v_sta_C</ci><ci>v_amy_C</ci></apply></apply>
    </math>
  </component>

