variablesini<-c(Malc=0,Malv=25,Malm=0,Pyr=0,Cit=0)
function(t,variables,k12,k1,k7,k9,k8,k10,k6){
with(as.list(c(variables,k12,k1,k7,k9,k8,k10,k6)),{
dMalc<-k12*Malv-k1*Malc-k7*Malc
dMalv<-k12*Malv
dMalm<-k7*Malc-k9*Malm-k8*Malm*Pyr+k10*Cit
dPyr<-k9*Malm-k8*Malm*Pyr-k6*Pyr
dCit<-k8*Malm*Pyr-k10*Cit
list(c(dMalc,dMalv,dMalm,dPyr,dCit))
})
}
equadif1<-function(t,variables,k12,k1,k7,k9,k8,k10,k6){
with(as.list(c(variables,k12,k1,k7,k9,k8,k10,k6)),{
dMalc<-k12*Malv-k1*Malc-k7*Malc
dMalv<-k12*Malv
dMalm<-k7*Malc-k9*Malm-k8*Malm*Pyr+k10*Cit
dPyr<-k9*Malm-k8*Malm*Pyr-k6*Pyr
dCit<-k8*Malm*Pyr-k10*Cit
list(c(dMalc,dMalv,dMalm,dPyr,dCit))
})
}
