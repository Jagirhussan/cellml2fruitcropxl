
###22/01 Analyse de donnée de Kliwer###
##Objectif : visualiser le jeu de donnée##

#Importer le fichier
Kliewer <- read.csv("~/Desktop/Kliewer.csv", dec=",")
#Fonction ggplot : necessite le package ggplot2

ggplot(data=don3, aes(Mois,Malate, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('Malate (mg/g)') + xlab('Week after veraison')
ggplot(data=don3, aes(Mois,Tartrate, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('Tartrate (mg/g)') + xlab('Week after veraison')
ggplot(data=don3, aes(Mois,brix, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('brix') + xlab('Week after veraison')
ggplot(data=don3, aes(Mois,FW, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('FW') + xlab('Week after veraison')
ggplot(data=don3, aes(Mois,pH, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('pH') + xlab('Week after veraison')
ggplot(data=don3, aes(Mois,K., colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('K+') + xlab('Week after veraison')
don3$Malate.baie=don3$Malate*don3$FW
ggplot(data=don3, aes(Mois,Malate.baie, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('Malate(mg/berry)') + xlab('Week after veraison')
don3$Tartrate.baie=don3$Tartrate*don3$FW
ggplot(data=don3, aes(Mois,Tartrate.baie, colour=cépage))+geom_point()+facet_wrap(~traitement+T) + ylab('Tartrate(mg/berry)') + xlab('Week after veraison')
savehistory("~/Analyse de donnée de Kliewer.Rhistory")
savehistory("~/Desktop/Analyse de donnée de Kliewer.Rhistory")
